.page { padding: 28rpx; padding-bottom: 80rpx; min-height: 100vh; background: radial-gradient(circle at 50% 0%, #22375d 0, #101827 45%, #090d18 100%); }
.hero-card { position: relative; height: 360rpx; overflow: hidden; border-radius: 34rpx; margin-bottom: 22rpx; box-shadow: 0 24rpx 70rpx rgba(0,0,0,.45); }
.hero-bg { position: absolute; width: 100%; height: 100%; }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(6,10,20,.9), rgba(6,10,20,.3)); }
.hero-content { position: relative; padding: 34rpx; z-index: 2; }
.eyebrow { color: #9ec2ff; font-size: 20rpx; letter-spacing: 2rpx; }
.title { font-size: 64rpx; font-weight: 900; margin-top: 8rpx; text-shadow: 0 8rpx 30rpx rgba(0,0,0,.5); }
.subtitle, .muted { color: #aebee0; font-size: 24rpx; line-height: 1.5; }
.hero-actions { display: flex; gap: 16rpx; margin-top: 34rpx; }
.card { background: rgba(23,32,51,.88); border: 1rpx solid rgba(97,130,190,.35); box-shadow: 0 10rpx 36rpx rgba(0,0,0,.28); border-radius: 26rpx; padding: 24rpx; margin: 18rpx 0; backdrop-filter: blur(14rpx); }
.config input, .nick { background: #0f1728; border-radius: 14rpx; padding: 14rpx; margin: 10rpx 0; color: white; }
.label { color: #9aa8c7; font-size: 22rpx; }
.identity { display: flex; align-items: center; gap: 18rpx; }
.identity-main { flex: 1; }
.avatar-btn { width: 92rpx; height: 92rpx; border-radius: 50%; padding: 0; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#25324e; }
.avatar-btn image, .mini-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; }
.stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.stat { background: linear-gradient(180deg, #263555, #172239); border-radius: 20rpx; padding: 14rpx 8rpx; text-align: center; }
.stat text { color: #93a4c7; display: block; font-size: 20rpx; }
.stat strong { font-size: 28rpx; color: #fff; }
.tabs { display: flex; background: #0f1728; border-radius: 22rpx; padding: 8rpx; margin: 22rpx 0; }
.tab { flex: 1; padding: 18rpx 8rpx; text-align: center; color: #aab7d2; border-radius: 18rpx; font-size: 25rpx; }
.tab.active { background: linear-gradient(135deg, #315eea, #8f49ff); color: white; font-weight: 800; }
.section-title { font-size: 30rpx; font-weight: 800; margin: 16rpx 0; }
.mt { margin-top: 28rpx; }
.picker { background: #0f1728; padding: 20rpx; border-radius: 18rpx; color: #f4f7ff; }
.mission { border-color: rgba(255,209,102,.36); background: linear-gradient(135deg, rgba(38,53,85,.94), rgba(20,28,47,.92)); }
.mission-top { display:flex; justify-content:space-between; align-items:flex-start; gap:18rpx; }
.mission-title { font-size:32rpx; font-weight:900; margin:6rpx 0; }
.mission-status { flex-shrink:0; padding:10rpx 16rpx; border-radius:999rpx; background:#263552; color:#b8c7e8; font-size:22rpx; font-weight:800; }
.mission-status.armed { background:rgba(255,209,102,.18); color:#ffe39b; }
.mission-status.ready { background:rgba(55,214,151,.18); color:#8ff0c9; }
.hint { margin-top:18rpx; padding:18rpx; border-radius:18rpx; background:rgba(15,23,40,.72); color:#dce7ff; line-height:1.5; font-size:24rpx; }
.mission-actions { display:flex; gap:14rpx; margin-top:16rpx; }
.mission-actions button { flex:1; margin-top:0; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.shop { margin: 0; min-height: 210rpx; }
.icon { font-size: 44rpx; margin-bottom: 8rpx; }
.shop-title { font-size: 28rpx; font-weight: 800; margin-bottom: 8rpx; }
.row, .rank, .target-top { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.row { padding: 12rpx 0; border-bottom: 1rpx solid #263552; }
.primary { background: linear-gradient(135deg, #ffd166, #f7b731); color: #1c1300; font-weight: 900; margin-top: 18rpx; }
.ghost { background: #25324e; color: #e6edff; }
.small { font-size: 24rpx; padding-left: 22rpx; padding-right: 22rpx; }
.danger { background: #472536; color: #ffd6e2; }
.target.selected { border-color: #f7b731; box-shadow: 0 0 0 3rpx #f7b731 inset, 0 0 40rpx rgba(247,183,49,.25); }
.badge { background: rgba(247,183,49,.18); color: #ffe39b; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; }
.report { white-space: pre-wrap; line-height: 1.55; }
.media-card { padding: 0; overflow: hidden; }
.scene-art { width: 100%; height: 260rpx; display: block; }
.scene-caption { padding: 18rpx 22rpx; color: #dce7ff; }
.world-map { position: relative; height: 250rpx; overflow: hidden; background: radial-gradient(circle at 50% 45%, #315eea, #172033 48%, #0f1728); }
.map-title { position: relative; z-index:2; font-size: 42rpx; font-weight: 900; margin-top: 38rpx; }
.pulse { position:absolute; border:2rpx solid rgba(255,209,102,.65); border-radius:50%; animation:pulse 2.8s infinite; }
.p1 { width:90rpx;height:90rpx;left:90rpx;top:76rpx; } .p2 { width:130rpx;height:130rpx;right:100rpx;top:50rpx; animation-delay:.7s; } .p3 { width:70rpx;height:70rpx;left:310rpx;bottom:38rpx; animation-delay:1.2s; }
.rank { padding: 14rpx 0; border-bottom: 1rpx solid #263552; }
.rank-no { width: 44rpx; color:#ffd166; font-weight:900; }
.rank-main { flex:1; } .rank-main text { color:#9aa8c7; font-size:22rpx; }
.battle-stage { height: 180rpx; display:flex; align-items:center; justify-content:center; gap:54rpx; font-size:70rpx; background: radial-gradient(circle, rgba(255,209,102,.22), transparent 58%); border-radius:24rpx; margin-bottom:16rpx; }
.slash { animation: flash .8s infinite alternate; }
.cinematic-battle .raider { animation: charge 1.1s infinite alternate; } .cinematic-battle .guardian { animation: shake .9s infinite; }
@keyframes pulse { from { transform:scale(.6); opacity:1 } to { transform:scale(2.8); opacity:0 } }
@keyframes flash { from { opacity:.25; transform:scale(.7) } to { opacity:1; transform:scale(1.2) } }
@keyframes charge { from { transform:translateX(-30rpx) } to { transform:translateX(30rpx) } }
@keyframes shake { 0%,100%{ transform:rotate(0)} 25%{transform:rotate(5deg)} 75%{transform:rotate(-5deg)} }
